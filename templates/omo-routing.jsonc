// OMO routing template — merge into ~/.omo/omo.jsonc under "[opencode]"
// Placeholders to resolve from setup step 4 discovery:
//   <main>    = cheapest fast reasoning model with long limits on Go
//              (2026: opencode-go/deepseek-v4-flash — 1M ctx / 384K out, fallback: deepseek-v4-pro)
//   <worker>  = cheapest fast model with long limits on Go
//              (2026: opencode-go/deepseek-v4-flash — 1M ctx / 384K out)
//   <planner> = cheap code-capable model for review/planning
//              (2026: opencode-go/qwen3.7-plus — 1M ctx, vision)
//   <free>    = last-resort free fallback (OpenCode Zen, no subscription)
//              (2026: opencode/muse-spark-1.3-contributor-free — 1M ctx / 131K out)
// Pricing policy: prefer cheap opencode-go models with long context/output
// (deepseek flash/pro, qwen). AVOID pricey tiers for routine work (kimi,
// full-size glm at ~$1+/$4+, and similar) — they only earn their cost at
// specialized niches; cheap flash variants with long limits are fair game.
// Every fallback chain MUST end with a free model so the setup keeps working on zero
// balance.
// Verified key format (oh-my-openagent 4.19.4): agents use "model" +
// "fallback_models" (array of strings; entries may be {"model", "reasoning"}
// objects) + optional "reasoning" (enum off|minimal|low|medium|high|xhigh|
// max|auto). NOTE: some OMO versions auto-migrate these keys — if doctor
// reports "Unknown config key: agents.X.models", the migration rewrote the
// file. Keep the root-level "_migrations" marker below so the migration
// never re-runs and the legacy format persists.
{
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 120,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    },
    "disabled_mcps": ["context7"],
    "agents": {
      "sisyphus": {
        "model": "<main>",
        "reasoning": "medium",
        "fallback_models": ["<planner>", "<free>"]
      },
      "sisyphus-junior": {
        "model": "<worker>",
        "fallback_models": ["<planner>", "<free>"]
      },
      "hephaestus": {
        "model": "<main>",
        "reasoning": "medium",
        "fallback_models": ["<planner>", "<free>"]
      },
      "oracle": {
        "model": "<main>",
        "reasoning": "high",
        "fallback_models": ["<planner>", "<free>"]
      },
      "momus": {
        "model": "<planner>",
        "fallback_models": ["<main>", "<free>"]
      },
      "librarian": {
        "model": "<planner>",
        "fallback_models": ["<worker>", "<free>"]
      },
      "prometheus": {
        "model": "<planner>",
        "reasoning": "high",
        "fallback_models": ["<main>", "<free>"]
      },
      "metis": {
        "model": "<planner>",
        "reasoning": "low",
        "fallback_models": ["<worker>", "<free>"]
      },
      "explore": {
        "model": "<worker>",
        "fallback_models": ["<planner>", "<free>"]
      },
      "atlas": {
        "model": "<planner>",
        "fallback_models": ["<main>", "<free>"]
      },
      "multimodal-looker": {
        "model": "<planner>",
        "fallback_models": ["<main>", "<free>"]
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "<planner>",
        "reasoning": "high",
        "fallback_models": ["<main>", "<free>"]
      },
      "ultrabrain": {
        "model": "<main>",
        "reasoning": "max",
        "fallback_models": ["<planner>", "<free>"]
      },
      "deep": {
        "model": "<main>",
        "reasoning": "high",
        "fallback_models": ["<planner>", "<free>"]
      },
      "artistry": {
        "model": "<planner>",
        "reasoning": "high",
        "fallback_models": ["<main>", "<free>"]
      },
      "quick": {
        "model": "<worker>",
        "fallback_models": ["<free>"]
      },
      "writing": {
        "model": "<planner>",
        "reasoning": "low",
        "fallback_models": ["<main>", "<free>"]
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}