// OMO routing template — merge into ~/.omo/omo.jsonc under "[opencode]"
// Placeholders to resolve from setup step 4 discovery:
//   <main>    = strongest stable reasoning model on Go
//              (2026: opencode-go/deepseek-v4-pro)
//   <worker>  = free/cheap fast model for light tasks
//              (2026: opencode/deepseek-v4-flash-free)
//   <planner> = cheap code-specialized "Claude-like" model for review/planning
//              (2026: opencode-go/kimi-k2.7-code)
// Verified key format (oh-my-openagent 4.19.4): agents use "model" +
// "fallback_models" (array of strings; entries may be {"model", "reasoning"}
// objects) + optional "reasoning" (enum off|minimal|low|medium|high|xhigh|
// max|auto). NOTE: some OMO versions auto-migrate these keys — if doctor
// reports "Unknown config key: agents.X.models", the migration rewrote the
// file. Keep the root-level "_migrations" marker below so the migration
// never re-runs and the legacy format persists.
{
  "[opencode]": {
    "model_fallback": true,
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [429, 500, 502, 503, 504],
      "max_fallback_attempts": 3,
      "cooldown_seconds": 30,
      "timeout_seconds": 120,
      "notify_on_fallback": true,
      "restore_primary_after_cooldown": true
    },
    "disabled_mcps": ["context7"],
    "agents": {
      "sisyphus": {
        "model": "<main>",
        "fallback_models": ["<planner>", "opencode/big-pickle"]
      },
      "sisyphus-junior": {
        "model": "<planner>",
        "fallback_models": ["<worker>", "opencode/big-pickle"]
      },
      "hephaestus": {
        "model": "<main>",
        "fallback_models": ["opencode-go/qwen3.7-max"]
      },
      "oracle": {
        "model": "opencode-go/qwen3.7-max",
        "fallback_models": ["<main>"]
      },
      "momus": {
        "model": "<planner>",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "librarian": {
        "model": "<planner>",
        "fallback_models": ["opencode-go/qwen3.7-plus"]
      },
      "prometheus": {
        "model": "<planner>",
        "reasoning": "high",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "metis": {
        "model": "<planner>",
        "reasoning": "low",
        "fallback_models": ["opencode-go/qwen3.7-plus"]
      },
      "explore": {
        "model": "<worker>",
        "fallback_models": ["opencode/big-pickle"]
      },
      "atlas": {
        "model": "<planner>",
        "fallback_models": ["opencode-go/qwen3.7-plus"]
      },
      "multimodal-looker": {
        "model": "opencode-go/kimi-k3"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "<planner>",
        "reasoning": "high",
        "fallback_models": ["opencode-go/glm-5.2"]
      },
      "ultrabrain": {
        "model": "<main>",
        "reasoning": "max"
      },
      "deep": {
        "model": "<main>",
        "reasoning": "max"
      },
      "artistry": {
        "model": "<planner>",
        "reasoning": "high"
      },
      "quick": {
        "model": "<worker>",
        "fallback_models": ["opencode/big-pickle"]
      },
      "writing": {
        "model": "<planner>",
        "reasoning": "low"
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification"
  ]
}
